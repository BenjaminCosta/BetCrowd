{
  "expo": {
    "name": "BetCrowd",
    "slug": "betcrowd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.betcrowd.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.betcrowd.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": ["betcrowd", "com.betcrowd.mobile"],
    "extra": {
      "eas": {
        "projectId": "104517fc-4f5f-4f9d-94c1-34accf18645a"
      }
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
