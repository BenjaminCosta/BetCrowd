rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // HELPERS
    // -------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isTournamentMember(tournamentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)/members/$(request.auth.uid));
    }

    function myRole(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/members/$(request.auth.uid)).data.role;
    }

    function isTournamentAdmin(tournamentId) {
      let role = myRole(tournamentId);
      return isTournamentMember(tournamentId) &&
        (role == "owner" || role == "admin");
    }

    function isTournamentOwnerDoc(tournamentId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId == request.auth.uid;
    }

    // -------------------------
    // USERS (private profile)
    // -------------------------
    match /users/{userId} {
      allow read: if isMe(userId);

      allow create, update: if isMe(userId)
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;

      match /tournamentRefs/{tournamentId} {
        allow read: if isMe(userId);

        // joinedAt is a serverTimestamp transform — NOT in request.resource.data
        allow create, update: if isMe(userId)
          && request.resource.data.keys().hasAll(["role"]);

        allow delete: if isMe(userId);
      }

      match /friends/{friendUid} {
        allow read: if isMe(userId);

        allow create: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == friendUid)
          && request.resource.data.uid == friendUid;

        allow delete: if isMe(userId);
      }

      match /incomingRequests/{fromUid} {
        allow read: if isMe(userId);

        allow create: if isSignedIn()
          && request.auth.uid == fromUid
          && request.resource.data.uid == fromUid;

        allow delete: if isMe(userId);
      }

      match /outgoingRequests/{toUid} {
        allow read: if isMe(userId);

        allow create: if isMe(userId)
          && request.resource.data.uid == toUid;

        allow delete: if isMe(userId)
          || (isSignedIn() && request.auth.uid == toUid);
      }

      match /notifications/{notificationId} {
        allow read: if isMe(userId);

        allow create: if isSignedIn()
          && (request.auth.uid == userId || request.resource.data.fromUid == request.auth.uid);

        allow update: if isMe(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);

        allow delete: if isMe(userId);
      }

      // picksIndex — written by the client to track user's picks across tournaments
      match /picksIndex/{entryId} {
        allow read, write: if isMe(userId);
      }
    }

    // -------------------------
    // PUBLIC PROFILES (search friends)
    // -------------------------
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();

      allow create, update: if isMe(uid)
        && request.resource.data.uid == uid
        && request.resource.data.usernameLower is string
        && request.resource.data.username is string
        && request.resource.data.displayName is string;

      allow delete: if false;
    }

    // -------------------------
    // USERNAMES (unique claim)
    // -------------------------
    match /usernames/{username} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(["uid"])
        && request.resource.data.uid == request.auth.uid;

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // -------------------------
    // INVITE CODES (index)
    // -------------------------
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(["tournamentId", "ownerId"])
        && request.resource.data.ownerId == request.auth.uid;

      // Members can progressively update the memberPreviews snapshot (shown in preview sheets)
      allow update: if isSignedIn()
        && isTournamentMember(resource.data.tournamentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberPreviews']);

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // -------------------------
    // TOURNAMENT INVITE LINKS (web landing)
    // -------------------------
    match /tournamentInviteLinks/{tournamentId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create, update: if isTournamentAdmin(tournamentId)
        && request.resource.data.tournamentId == tournamentId
        && request.resource.data.keys().hasOnly([
          "tournamentId",
          "token",
          "inviteCode",
          "createdBy",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "status"
        ])
        && request.resource.data.keys().hasAll([
          "tournamentId",
          "token",
          "inviteCode",
          "createdBy",
          "expiresAt",
          "status"
        ])
        && request.resource.data.status in ["active", "revoked", "expired"];

      allow delete: if isTournamentAdmin(tournamentId);
    }

    // -------------------------
    // TOURNAMENTS
    // -------------------------
    match /tournaments/{tournamentId} {

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          "name",
          "format",
          "contribution",
          "participantsEstimated",
          "ownerId",
          "inviteCode",
          "status"
        ]);

      allow get, list: if isTournamentMember(tournamentId);

      allow update: if isTournamentAdmin(tournamentId);

      allow delete: if false;

      // -------------------------
      // MEMBERS
      // -------------------------
      match /members/{uid} {
        allow read: if isTournamentMember(tournamentId);

        allow create: if isSignedIn()
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/members/$(uid))
          && (
            isTournamentAdmin(tournamentId)
            || (
              request.auth.uid == uid
              && (
                request.resource.data.role == "member"
                || (
                  (request.resource.data.role == "owner" || request.resource.data.role == "admin")
                  // Either the tournament exists and this user owns it,
                  // OR the tournament doesn't exist yet (created in same batch)
                  && (
                    isTournamentOwnerDoc(tournamentId)
                    || !exists(/databases/$(database)/documents/tournaments/$(tournamentId))
                  )
                )
              )
            )
          )
          && request.resource.data.keys().hasAll(["role"])
          && request.resource.data.role in ["owner", "admin", "member"];

        allow update, delete: if isTournamentAdmin(tournamentId);
      }

      // -------------------------
      // EVENTS
      // -------------------------
      match /events/{eventId} {
        allow read: if isTournamentMember(tournamentId);
        allow create, update, delete: if isTournamentAdmin(tournamentId);

        // -------------------------
        // BETS
        // -------------------------
        match /bets/{betId} {
          // ✅ read: cualquier miembro
          allow read: if isTournamentMember(tournamentId);

          // ✅ create/delete: solo admin/owner
          allow create, delete: if isTournamentAdmin(tournamentId);

          // ✅ update:
          // - Admin: todo
          // - Member: SOLO los campos de agregados del pool, y SOLO si el bet está abierto o pendiente.
          //   Campos permitidos: totalPot, totalPicks, optionTotals, updatedAt
          //   También permite la transición automática pending -> open cuando aparece contraparte.
          allow update: if isTournamentAdmin(tournamentId)
            || (
              isTournamentMember(tournamentId)
              && resource.data.status in ["pending", "open"]
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["totalPot", "totalPicks", "optionTotals", "updatedAt"])
            )
            || (
              // Members can auto-transition pending -> open when second side fills in
              isTournamentMember(tournamentId)
              && resource.data.status == "pending"
              && request.resource.data.status == "open"
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["status", "totalPot", "totalPicks", "optionTotals", "updatedAt"])
            );

          // -------------------------
          // PICKS (docId = uid)
          // -------------------------
          match /picks/{uid} {
            // ✅ read: cualquier miembro (necesario para listenBetPicks y calcular pool client-side)
            allow read: if isTournamentMember(tournamentId);

            // ✅ create/update: el usuario solo puede escribir su propio pick y solo si el bet está open o pending
            allow create, update: if isTournamentMember(tournamentId)
              && request.auth.uid == uid
              && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/events/$(eventId)/bets/$(betId))
              && get(/databases/$(database)/documents/tournaments/$(tournamentId)/events/$(eventId)/bets/$(betId)).data.status in ["pending", "open"];

            // ✅ hide/restore: el usuario puede actualizar SOLO hiddenFromPredictionsAt (+ updatedAt)
            //    en su propio pick sin importar el estado del bet (ej. settled/cancelled).
            //    Este campo es solo de display — no afecta totales ni resultados.
            allow update: if isTournamentMember(tournamentId)
              && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(["hiddenFromPredictionsAt", "updatedAt"]);

            // ✅ delete: el usuario borra su propio pick (solo si bet abierto/pendiente)
            //    o un admin elimina picks de cualquier usuario (ej. al quitar un miembro)
            allow delete: if isTournamentAdmin(tournamentId)
              || (
                isTournamentMember(tournamentId)
                && request.auth.uid == uid
                && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/events/$(eventId)/bets/$(betId))
                && get(/databases/$(database)/documents/tournaments/$(tournamentId)/events/$(eventId)/bets/$(betId)).data.status in ["pending", "open"]
              );
          }
        }
      }

      // -------------------------
      // TOURNAMENT INVITES (OPCIONAL)
      // -------------------------
      match /invites/{uid} {
        allow read: if isSignedIn() && (
          request.auth.uid == uid || isTournamentMember(tournamentId)
        );

        allow create: if isTournamentAdmin(tournamentId);

        allow update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);

        allow delete: if isSignedIn() && (
          request.auth.uid == uid || isTournamentAdmin(tournamentId)
        );
      }

      // -------------------------
      // (Legacy) PREDICTIONS
      // -------------------------
      match /predictions/{predictionId} {
        allow read: if isTournamentMember(tournamentId);

        allow create: if isTournamentMember(tournamentId)
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isTournamentMember(tournamentId)
          && resource.data.userId == request.auth.uid;
      }
    }

    // -------------------------
    // TOURNAMENT INVITES (global collection)
    // -------------------------
    match /tournamentInvites/{inviteId} {
      // fromUid or toUid can read their own invites
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid  == request.auth.uid);

      // Only signed-in tournament members can create an invite
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.keys().hasAll([
             "tournamentId", "tournamentName", "fromUid", "toUid", "status"
           ])
        && request.resource.data.status == "pending"
        && exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)/members/$(request.auth.uid));

      // toUid can accept/reject; fromUid can cancel;
      // each actor can set their own hiddenBy flag to soft-hide the invite.
      // Security: actor may only flip their own flag and cannot touch the other's.
      allow update: if isSignedIn()
        && (
          // ── Status transitions (accept / reject / cancel) ─────────────────
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
            && (
              // toUid: pending → accepted | rejected
              (
                request.auth.uid == resource.data.toUid
                && resource.data.status == "pending"
                && request.resource.data.status in ["accepted", "rejected"]
              )
              ||
              // fromUid: pending → cancelled
              (
                request.auth.uid == resource.data.fromUid
                && resource.data.status == "pending"
                && request.resource.data.status == "cancelled"
              )
            )
          )
          ||
          // ── hiddenBy.from: sender soft-hides their sent invite ────────────
          // Only fromUid may set hiddenBy.from = true; cannot touch hiddenBy.to.
          (
            request.auth.uid == resource.data.fromUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenBy", "updatedAt"])
            && request.resource.data.hiddenBy.get("from", false) == true
            && request.resource.data.hiddenBy.get("to", false) == resource.data.get("hiddenBy", {}).get("to", false)
          )
          ||
          // ── hiddenBy.to: recipient soft-hides their received invite ───────
          // Only toUid may set hiddenBy.to = true; cannot touch hiddenBy.from.
          (
            request.auth.uid == resource.data.toUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenBy", "updatedAt"])
            && request.resource.data.hiddenBy.get("to", false) == true
            // Allow if the stored hiddenBy.from is already true (concurrent sender hide)
            // OR if the writer is preserving the current value exactly (no-race case).
            && (
                 resource.data.get("hiddenBy", {}).get("from", false) == true
                 || request.resource.data.hiddenBy.get("from", false) == resource.data.get("hiddenBy", {}).get("from", false)
               )
          )
        );

      allow delete: if false;
    }

    // -------------------------
    // DENY BY DEFAULT
    // -------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
